{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monitor-chile.local/schemas/engine-snapshot.schema.json",
  "title": "Monitor Chile source engine snapshot",
  "description": "Source-specific staging contract; an aggregation step maps snapshots into the four frontend mock-data contracts.",
  "type": "object",
  "required": ["schemaVersion", "source", "generatedAt", "indicators"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "enum": ["BCCh", "INE", "DIPRES", "MDS-CASEN"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "period", "value", "unit", "frequency", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "nameEn": { "type": "string" },
          "period": { "type": "string", "pattern": "^\\d{4}-(\\d{2}|Q[1-4]|H[1-2])$" },
          "value": { "type": ["number", "null"] },
          "unit": { "type": "string", "minLength": 1 },
          "frequency": { "enum": ["daily", "monthly", "quarterly", "annual", "rolling"] },
          "status": { "enum": ["final", "preliminary", "estimated", "revised", "delayed"] },
          "category": { "type": "string" },
          "publishedAt": { "type": ["string", "null"], "format": "date-time" },
          "sourceUrl": { "type": "string", "format": "uri" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
